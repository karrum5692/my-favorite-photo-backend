// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum ProviderType {
  GOOGLE
}

enum Grade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum Genre {
  ALBUM
  SPECIAL
  FAN_SIGN
  SEASON_GREETING
  FAN_MEETING
  CONCERT
  MD
  COLLABORATION
  FAN_CLUB
  OTHER
}

enum PhotoCardStatus {
  OWNED
  ON_SALE
  IN_TRADE
  SOLD_OUT
}

enum SaleStatus {
  SELLING
  SOLD
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PURCHASE_COMPLETED
  SOLD
  SOLD_OUT
}

enum NotificationRelatedType {
  SALE_LISTING
  TRADE_PROPOSAL
  PURCHASE
}

enum PointType {
  RANDOM_BOX
  PURCHASE
  SALE
}

// =====================
// Models
// =====================

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  password        String?
  providerId      String?       @unique
  providerType    ProviderType?
  nickname        String
  profileImageUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt

  point          Point?
  pointHistories PointHistory[]
  refreshToken   RefreshToken?
  cardTemplates  CardTemplate[]
  photoCards     PhotoCard[]
  saleListings   SaleListing[]
  purchases      Purchase[]      @relation("BuyerPurchases")
  sales          Purchase[]      @relation("SellerPurchases")
  tradeProposals TradeProposal[]
  notifications  Notification[]
}

model Point {
  id          Int       @id @default(autoincrement())
  userId      String    @unique @db.Uuid
  balance     Int       @default(0)
  lastEventAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model PointHistory {
  id         Int       @id @default(autoincrement())
  userId     String    @db.Uuid
  purchaseId Int?
  amount     Int
  type       PointType
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @db.Uuid
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CardTemplate {
  id          Int       @id @default(autoincrement())
  creatorId   String    @db.Uuid
  title       String
  description String?
  imageUrl    String
  grade       Grade
  genre       Genre
  price       Int
  totalIssued Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  creator    User        @relation(fields: [creatorId], references: [id])
  photoCards PhotoCard[]
}

model PhotoCard {
  id         Int             @id @default(autoincrement())
  templateId Int
  ownerId    String          @db.Uuid
  quantity   Int             @default(1)
  status     PhotoCardStatus @default(OWNED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime?       @updatedAt

  template       CardTemplate    @relation(fields: [templateId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  saleListings   SaleListing[]
  purchases      Purchase[]
  tradeProposals TradeProposal[]

  @@unique([templateId, ownerId])
  @@index([ownerId, status])
}

model SaleListing {
  id                  Int        @id @default(autoincrement())
  sellerId            String     @db.Uuid
  photoCardId         Int
  quantity            Int
  remainQuantity      Int
  price               Int
  status              SaleStatus @default(SELLING)
  exchangeGrade       Grade?
  exchangeGenre       Genre?
  exchangeDescription String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime?  @updatedAt

  seller         User            @relation(fields: [sellerId], references: [id])
  photoCard      PhotoCard       @relation(fields: [photoCardId], references: [id])
  purchases      Purchase[]
  tradeProposals TradeProposal[]

  // NOTE: photoCardId unique는 SELLING 상태일 때만 적용 - DB에서 partial unique index로 직접 설정 필요
  // CREATE UNIQUE INDEX sale_listing_photocard_selling_unique
  //   ON "SaleListing" ("photoCardId") WHERE status = 'SELLING';
}

model Purchase {
  id            Int      @id @default(autoincrement())
  buyerId       String   @db.Uuid
  sellerId      String   @db.Uuid
  photoCardId   Int
  saleListingId Int
  quantity      Int
  price         Int
  createdAt     DateTime @default(now())

  buyer          User           @relation("BuyerPurchases", fields: [buyerId], references: [id])
  seller         User           @relation("SellerPurchases", fields: [sellerId], references: [id])
  photoCard      PhotoCard      @relation(fields: [photoCardId], references: [id])
  saleListing    SaleListing    @relation(fields: [saleListingId], references: [id])
  pointHistories PointHistory[]
}

model TradeProposal {
  id            Int            @id @default(autoincrement())
  saleListingId Int
  proposerId    String         @db.Uuid
  offeredCardId Int
  quantity      Int            @default(1)
  status        ProposalStatus @default(PENDING)
  message       String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime?      @updatedAt

  saleListing SaleListing @relation(fields: [saleListingId], references: [id])
  proposer    User        @relation(fields: [proposerId], references: [id])
  offeredCard PhotoCard   @relation(fields: [offeredCardId], references: [id])

  // NOTE: (saleListingId, offeredCardId, proposerId) unique는 PENDING 상태일 때만 적용
  // CREATE UNIQUE INDEX trade_proposal_pending_unique
  //   ON "TradeProposal" ("saleListingId", "offeredCardId", "proposerId") WHERE status = 'PENDING';
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @db.Uuid
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}
