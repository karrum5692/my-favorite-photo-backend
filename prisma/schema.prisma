generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// ENUMS
// =====================

enum ProviderType {
  GOOGLE
}

enum Grade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum Genre {
  ALBUM
  SPECIAL
  FAN_SIGN
  SEASON_GREETING
  FAN_MEETING
  CONCERT
  MD
  COLLABORATION
  FAN_CLUB
  OTHER
}

enum PhotoCardStatus {
  OWNED
  ON_SALE
  IN_TRADE
  SOLD_OUT
}

enum SaleStatus {
  SELLING
  SOLD
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PURCHASE_COMPLETED
  SOLD
  SOLD_OUT
}

enum PointType {
  RANDOM_BOX
  PURCHASE
  SALE
}

// =====================
// USER
// =====================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String?
  nickname  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  point      Point?

  photoCards     PhotoCard[]
  saleListings    SaleListing[]
  tradeProposals  TradeProposal[]
  notifications   Notification[]
  cardTemplates   CardTemplate[]
}

// =====================
// POINT
// =====================

model Point {
  id      Int    @id @default(autoincrement())
  userId  String @unique @db.Uuid
  balance Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}

// =====================
// CARD TEMPLATE
// =====================

model CardTemplate {
  id          Int      @id @default(autoincrement())
  creatorId   String   @db.Uuid

  title       String
  description String?
  imageUrl    String

  grade       Grade
  genre       Genre
  price       Int
  totalIssued Int

  createdAt   DateTime @default(now())

  creator    User        @relation(fields: [creatorId], references: [id])
  photoCards PhotoCard[]
}

// =====================
// PHOTO CARD
// =====================

model PhotoCard {
  id          Int             @id @default(autoincrement())

  templateId  Int
  ownerId     String         @db.Uuid

  quantity    Int            @default(1)
  status      PhotoCardStatus @default(OWNED)

  createdAt   DateTime @default(now())

  template CardTemplate @relation(fields: [templateId], references: [id])
  owner    User         @relation(fields: [ownerId], references: [id])

  saleListings   SaleListing[]
  tradeProposals TradeProposal[]

  @@index([ownerId])
}

// =====================
// SALE LISTING
// =====================

model SaleListing {
  id              Int        @id @default(autoincrement())

  sellerId        String     @db.Uuid
  photoCardId     Int

  quantity        Int
  remainQuantity  Int
  price           Int

  status          SaleStatus @default(SELLING)

  exchangeGrade   Grade?
  exchangeGenre   Genre?
  exchangeDescription String?

  createdAt DateTime @default(now())

  seller    User      @relation(fields: [sellerId], references: [id])
  photoCard PhotoCard @relation(fields: [photoCardId], references: [id])

  tradeProposals TradeProposal[]
}

// =====================
// TRADE PROPOSAL
// =====================

model TradeProposal {
  id              Int            @id @default(autoincrement())

  saleListingId   Int
  proposerId      String         @db.Uuid
  offeredCardId   Int

  quantity        Int            @default(1)
  status          ProposalStatus @default(PENDING)

  message         String?
  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  saleListing SaleListing @relation(fields: [saleListingId], references: [id])
  proposer    User        @relation(fields: [proposerId], references: [id])
  offeredCard PhotoCard   @relation(fields: [offeredCardId], references: [id])

  @@index([saleListingId])
  @@index([proposerId])
}

// =====================
// NOTIFICATION
// =====================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid

  type      NotificationType
  message   String
  isRead    Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}