datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =====================
// ENUMS
// =====================

enum ProviderType {
  GOOGLE
}

enum Grade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum Genre {
  ALBUM
  SPECIAL
  FAN_SIGN
  SEASON_GREETING
  FAN_MEETING
  CONCERT
  MD
  COLLABORATION
  FAN_CLUB
  OTHER
}

enum PhotoCardStatus {
  OWNED
  ON_SALE
  IN_TRADE
  SOLD_OUT
}

enum SaleStatus {
  SELLING
  SOLD
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PURCHASE_COMPLETED
  SOLD
  SOLD_OUT
}

enum PointType {
  RANDOM_BOX
  PURCHASE
  SALE
}

// =====================
// TABLES
// =====================

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar
  password        String?       @db.VarChar
  providerId      String?       @unique @db.VarChar
  providerType    ProviderType?
  nickname        String        @db.VarChar
  profileImageUrl String?       @db.VarChar
  createdAt       DateTime      @default(now()) @db.Timestamp
  updatedAt       DateTime      @updatedAt @db.Timestamp

  // Relations
  point          Point?
  pointHistories PointHistory[]
  refreshToken   RefreshToken?
  cardTemplates  CardTemplate[]
  photoCards     PhotoCard[]
  saleListings   SaleListing[]
  purchased      Purchase[]      @relation("BuyerPurchases")
  sales          Purchase[]      @relation("SellerPurchases")
  tradeProposals TradeProposal[]
  notifications  Notification[]
}

model Point {
  id          Int       @id @default(autoincrement())
  userId      String    @unique @db.Uuid
  balance     Int       @default(0)
  lastEventAt DateTime? @db.Timestamp
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointHistory {
  id         Int       @id @default(autoincrement())
  userId     String    @db.Uuid
  purchaseId Int?
  amount     Int
  type       PointType
  createdAt  DateTime  @default(now()) @db.Timestamp

  // Relations
  user     User      @relation(fields: [userId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @db.Uuid
  token     String   @db.VarChar
  expiresAt DateTime @db.Timestamp
  createdAt DateTime @default(now()) @db.Timestamp

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CardTemplate {
  id          Int      @id @default(autoincrement())
  creatorId   String   @db.Uuid
  title       String   @db.VarChar
  description String?  @db.VarChar
  imageUrl    String   @db.VarChar
  grade       Grade
  genre       Genre
  price       Int
  totalIssued Int
  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt @db.Timestamp

  // Relations
  creator User        @relation(fields: [creatorId], references: [id])
  cards   PhotoCard[]

  // Indexes
  @@index([creatorId])
}

model PhotoCard {
  id         Int             @id @default(autoincrement())
  templateId Int
  ownerId    String          @db.Uuid
  quantity   Int             @default(1)
  status     PhotoCardStatus @default(OWNED)
  createdAt  DateTime        @default(now()) @db.Timestamp
  updatedAt  DateTime        @updatedAt @db.Timestamp

  // Relations
  template       CardTemplate    @relation(fields: [templateId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  saleListings   SaleListing[]
  purchases      Purchase[]
  tradeProposals TradeProposal[]

  // Indexes
  @@unique([templateId, ownerId])
  @@index([ownerId, status])
  @@index([templateId])
}

model SaleListing {
  id                  Int        @id @default(autoincrement())
  sellerId            String     @db.Uuid
  photoCardId         Int
  quantity            Int
  remainQuantity      Int
  price               Int
  status              SaleStatus @default(SELLING)
  exchangeGrade       Grade?
  exchangeGenre       Genre?
  exchangeDescription String?    @db.VarChar
  createdAt           DateTime   @default(now()) @db.Timestamp
  updatedAt           DateTime   @updatedAt @db.Timestamp

  // Relations
  seller         User            @relation(fields: [sellerId], references: [id])
  photoCard      PhotoCard       @relation(fields: [photoCardId], references: [id])
  purchases      Purchase[]
  tradeProposals TradeProposal[]

  // Indexes
  @@index([sellerId])
  @@index([status])
  @@index([photoCardId])
}

model Purchase {
  id            Int      @id @default(autoincrement())
  buyerId       String   @db.Uuid
  sellerId      String   @db.Uuid
  photoCardId   Int
  saleListingId Int
  quantity      Int
  price         Int
  createdAt     DateTime @default(now()) @db.Timestamp

  // Relations
  buyer        User           @relation("BuyerPurchases", fields: [buyerId], references: [id])
  seller       User           @relation("SellerPurchases", fields: [sellerId], references: [id])
  photoCard    PhotoCard      @relation(fields: [photoCardId], references: [id])
  saleListing  SaleListing    @relation(fields: [saleListingId], references: [id])
  pointHistory PointHistory[]
}

model TradeProposal {
  id            Int            @id @default(autoincrement())
  saleListingId Int
  proposerId    String         @db.Uuid
  offeredCardId Int
  quantity      Int            @default(1)
  status        ProposalStatus @default(PENDING)
  message       String?        @db.VarChar
  completedAt   DateTime?      @db.Timestamp
  createdAt     DateTime       @default(now()) @db.Timestamp
  updatedAt     DateTime       @updatedAt @db.Timestamp

  // Relations
  saleListing SaleListing @relation(fields: [saleListingId], references: [id])
  proposer    User        @relation(fields: [proposerId], references: [id])
  offeredCard PhotoCard   @relation(fields: [offeredCardId], references: [id])

  // Indexes
  @@unique([saleListingId, proposerId])
  @@index([saleListingId])
  @@index([proposerId])
  @@index([status])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @db.Uuid
  type      NotificationType
  message   String           @db.VarChar
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamp

  // Relations
  user User @relation(fields: [userId], references: [id])
}
