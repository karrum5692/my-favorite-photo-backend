// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum ProviderType {
  GOOGLE
}

enum Grade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum Genre {
  ALBUM
  SPECIAL
  FAN_SIGN
  SEASON_GREETING
  FAN_MEETING
  CONCERT
  MD
  COLLABORATION
  FAN_CLUB
  OTHER
}

enum PhotoCardStatus {
  OWNED
  ON_SALE
  IN_TRADE
  SOLD_OUT
}

enum SaleStatus {
  SELLING
  SOLD
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PURCHASE_COMPLETED
  SOLD
  SOLD_OUT
}

enum PointType {
  RANDOM_BOX
  PURCHASE
  SALE
}

// =====================
// Models
// =====================

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  password        String? // null: OAuth 로그인 전용
  providerId      String?       @unique // null: 일반 로그인 전용
  providerType    ProviderType? // null: 일반 로그인 전용
  nickname        String
  profileImageUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 관계
  point          Point?
  refreshToken   RefreshToken?
  cardTemplates  CardTemplate[]
  photoCards     PhotoCard[]
  saleListings   SaleListing[]
  purchases      Purchase[]      @relation("BuyerPurchases")
  sales          Purchase[]      @relation("SellerPurchases")
  tradeProposals TradeProposal[]
  notifications  Notification[]
  pointHistories PointHistory[]
}

// 포인트 잔액 (User와 1:1)
model Point {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  balance   Int      @default(0) // 현재 잔액
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  user User @relation(fields: [userId], references: [id])
}

// 포인트 변동 내역
model PointHistory {
  id         Int       @id @default(autoincrement())
  userId     String
  purchaseId Int? // null: 구매 외 포인트 변동
  amount     Int // 양수: 적립 / 음수: 차감
  type       PointType
  createdAt  DateTime  @default(now())

  // 관계
  user     User      @relation(fields: [userId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
}

// 리프레시 토큰 (User와 1:1)
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id])
}

// 포토카드 원형 정보
model CardTemplate {
  id          Int      @id @default(autoincrement())
  creatorId   String
  title       String
  description String?
  imageUrl    String
  grade       Grade
  genre       Genre
  totalIssued Int // 총 발행 수량
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  creator    User        @relation(fields: [creatorId], references: [id])
  photoCards PhotoCard[]
}

// 유저가 보유한 포토카드 (같은 카드는 quantity로 관리)
model PhotoCard {
  id         Int             @id @default(autoincrement())
  templateId Int
  ownerId    String
  quantity   Int             @default(1) // 보유 수량
  status     PhotoCardStatus @default(OWNED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // 관계
  template       CardTemplate    @relation(fields: [templateId], references: [id])
  owner          User            @relation(fields: [ownerId], references: [id])
  saleListings   SaleListing[]
  purchases      Purchase[]
  tradeProposals TradeProposal[]

  @@unique([templateId, ownerId]) // 유저당 카드 중복 레코드 방지
  @@index([ownerId, status]) // 내 카드 상태별 조회 최적화
}

// 판매 등록
model SaleListing {
  id                  Int        @id @default(autoincrement())
  sellerId            String
  photoCardId         Int
  quantity            Int // 판매 수량
  price               Int // 판매 가격 (포인트)
  status              SaleStatus @default(SELLING)
  exchangeGrade       Grade? // 교환 희망 등급
  exchangeGenre       Genre? // 교환 희망 장르
  exchangeDescription String? // 교환 희망 상세 설명
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // 관계
  seller         User            @relation(fields: [sellerId], references: [id])
  photoCard      PhotoCard       @relation(fields: [photoCardId], references: [id])
  purchases      Purchase[]
  tradeProposals TradeProposal[]

  // SELLING 상태일 때만 unique - 마이그레이션에서 직접 설정 필요
  @@index([photoCardId, status])
}

// 구매 완료 기록
model Purchase {
  id            Int      @id @default(autoincrement())
  buyerId       String
  sellerId      String
  photoCardId   Int
  saleListingId Int
  quantity      Int // 구매 수량
  price         Int // 거래 시점 가격
  createdAt     DateTime @default(now())

  // 관계
  buyer        User           @relation("BuyerPurchases", fields: [buyerId], references: [id])
  seller       User           @relation("SellerPurchases", fields: [sellerId], references: [id])
  photoCard    PhotoCard      @relation(fields: [photoCardId], references: [id])
  saleListing  SaleListing    @relation(fields: [saleListingId], references: [id])
  pointHistory PointHistory[]
}

// 교환 제안
model TradeProposal {
  id            Int            @id @default(autoincrement())
  saleListingId Int
  proposerId    String
  offeredCardId Int
  quantity      Int            @default(1) // 제안 수량
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 관계
  saleListing SaleListing @relation(fields: [saleListingId], references: [id])
  proposer    User        @relation(fields: [proposerId], references: [id])
  offeredCard PhotoCard   @relation(fields: [offeredCardId], references: [id])
}

// 알림
model Notification {
  id        Int              @id @default(autoincrement())
  userId    String
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id])
}
